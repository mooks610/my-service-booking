rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'mooks610@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // 3. Entity Validation Blueprints (create + update safe; no existing()/diff())
    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'displayName', 'department', 'role', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'department', 'role', 'email', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.department is string && data.department.size() >= 1 && data.department.size() <= 80
        && data.role is string && data.role.size() >= 1 && data.role.size() <= 80
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidResource(data) {
      return data.keys().hasAll([
          'name', 'category', 'visualType', 'floor', 'zone', 'capacity',
          'amenities', 'description', 'operationalStatus', 'visibility',
          'createdByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'category', 'visualType', 'floor', 'zone', 'capacity',
          'amenities', 'description', 'operationalStatus', 'visibility',
          'createdByUid', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.category is string && data.category.size() <= 32
        && data.category in ['meeting_room', 'focus_booth', 'equipment']
        && data.visualType is string && data.visualType.size() <= 32
        && data.visualType in ['boardroom', 'studio', 'scrum', 'booth', 'equipment']
        && data.floor is string && data.floor.size() >= 1 && data.floor.size() <= 32
        && data.zone is string && data.zone.size() >= 1 && data.zone.size() <= 64
        && data.capacity is number && data.capacity >= 1 && data.capacity <= 200
        && data.amenities is list && data.amenities.size() >= 1 && data.amenities.size() <= 10
        && data.amenities[0] is string && data.amenities[0].size() >= 1 && data.amenities[0].size() <= 40
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 300
        && data.operationalStatus is string && data.operationalStatus.size() <= 32
        && data.operationalStatus in ['active', 'maintenance']
        && data.visibility is string && data.visibility.size() <= 32 && data.visibility == 'workspace'
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
          'ownerUid', 'resourceId', 'resourceName', 'title',
          'organizerName', 'organizerDepartment', 'date', 'startMin', 'endMin',
          'attendeesCount', 'notes', 'checkedIn', 'status', 'lifecycleStatus',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'resourceId', 'resourceName', 'title',
          'organizerName', 'organizerDepartment', 'date', 'startMin', 'endMin',
          'attendeesCount', 'notes', 'checkedIn', 'status', 'lifecycleStatus',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && isValidId(data.resourceId)
        && data.resourceName is string && data.resourceName.size() >= 1 && data.resourceName.size() <= 80
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.organizerName is string && data.organizerName.size() >= 1 && data.organizerName.size() <= 80
        && data.organizerDepartment is string && data.organizerDepartment.size() >= 1 && data.organizerDepartment.size() <= 80
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.startMin is number && data.startMin >= 0 && data.startMin < 1440
        && data.endMin is number && data.endMin > data.startMin && data.endMin <= 1440
        && data.attendeesCount is number && data.attendeesCount >= 1 && data.attendeesCount <= 200
        && data.notes is string && data.notes.size() <= 500
        && data.checkedIn is bool
        && data.status is string && data.status.size() <= 32 && data.status in ['confirmed', 'cancelled']
        && data.lifecycleStatus is string && data.lifecycleStatus.size() <= 32
        && data.lifecycleStatus in ['scheduled', 'in_progress', 'completed', 'cancelled']
        && (
          (data.status == 'cancelled' && data.lifecycleStatus == 'cancelled') ||
          (data.status == 'confirmed' && data.lifecycleStatus in ['scheduled', 'in_progress', 'completed'])
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidUserAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'department', 'role', 'updatedAt']);
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /resources/{resourceId} {
      allow get: if isVerifiedUser() && isValidId(resourceId) && (resource == null || existing().visibility == 'workspace');
      allow list: if isVerifiedUser() && resource.data.visibility == 'workspace';
      allow create: if isVerifiedUser()
        && isValidId(resourceId)
        && isValidResource(incoming())
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(resourceId)
        && isValidResource(incoming())
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (existing().createdByUid == request.auth.uid || isAdmin())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'category', 'visualType', 'floor', 'zone', 'capacity',
          'amenities', 'description', 'operationalStatus', 'updatedAt'
        ]);
      allow delete: if isValidId(resourceId) && isAdmin();
    }

    match /bookings/{bookingId} {
      allow get: if isVerifiedUser()
        && isValidId(bookingId)
        && (resource == null || existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/resources/$(incoming().resourceId));
      allow update: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().resourceId == existing().resourceId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid
            && existing().status == 'confirmed'
            && existing().lifecycleStatus != 'cancelled'
            && existing().lifecycleStatus != 'completed'
            && (
              // Action 1: Check-In
              (incoming().diff(existing()).affectedKeys().hasOnly(['checkedIn', 'lifecycleStatus', 'updatedAt'])
                && incoming().checkedIn == true) ||
              // Action 2: Mark Completed
              (incoming().diff(existing()).affectedKeys().hasOnly(['lifecycleStatus', 'updatedAt'])
                && incoming().lifecycleStatus == 'completed') ||
              // Action 3: Cancel Booking (terminal transition)
              (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lifecycleStatus', 'updatedAt'])
                && incoming().status == 'cancelled'
                && incoming().lifecycleStatus == 'cancelled') ||
              // Action 4: Modify Schedule / Details / Extend
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'date', 'startMin', 'endMin', 'attendeesCount', 'notes', 'lifecycleStatus', 'updatedAt'
              ])
            )
          )
        );
      allow delete: if isVerifiedUser()
        && isValidId(bookingId)
        && (existing().ownerUid == request.auth.uid || isAdmin());
    }
  }
}
